{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@thunk/language-core": ["./packages/language-core/src/index.ts"],
      "@thunk/language-service": ["./packages/language-service/src/index.ts"],
      "@thunk/runtime": ["./packages/runtime/src/index.ts"],
      "@thunk/types": ["./packages/types/src/index.ts"],
      "@thunk/compiler": ["./packages/compiler/src/index.ts"]
    }
  },
  "include": ["packages/**/*", "scripts/**/*", "examples/**/*"]
}
