{
  "scopeName": "source.thunk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.thunk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.thunk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.thunk",
          "match": "\\b(thunk|run|return|const|let)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.thunk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.thunk", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.thunk",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.thunk", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.thunk",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  }
}
