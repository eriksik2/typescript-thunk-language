// Control-flow showcase for Thunk.
//
// Restriction (prototype): `run` stays at thunk statement-list position.
// Nested if/for/while/switch/try mutate locals; the thunk result is a final
// top-level `return`.

function clamp(n: number, min: number, max: number): number {
  if (n < min) return min
  if (n > max) return max
  return n
}

const seedValues: number[] = [3, -1, 8, 0, 5, 2, 9, 4]

const classify = thunk {
  let positives = 0
  let negatives = 0
  let zeros = 0

  for (const value of seedValues) {
    if (value > 0) {
      positives += 1
    } else if (value < 0) {
      negatives += 1
    } else {
      zeros += 1
    }
  }

  let label = "mixed"
  switch (true) {
    case negatives === 0 && zeros === 0:
      label = "all-positive"
      break
    case positives === 0 && zeros === 0:
      label = "all-negative"
      break
    case positives === 0 && negatives === 0:
      label = "all-zero"
      break
    default:
      label = "mixed"
      break
  }

  return {
    positives,
    negatives,
    zeros,
    label,
  }
}

const accumulate = thunk {
  let total = 0
  let i = 0

  while (i < seedValues.length) {
    const value = seedValues[i]!
    i += 1

    if (value <= 0) {
      continue
    }

    total += value

    if (total > 20) {
      break
    }
  }

  let doubled = 0
  do {
    doubled = total * 2
  } while (false)

  return {
    total,
    doubled,
    stoppedEarly: total > 20 || i < seedValues.length,
  }
}

const guarded = thunk {
  let recovered = false
  let message = "ok"
  let answer = 0

  try {
    for (const value of seedValues) {
      if (value === 0) {
        throw new Error("zero encountered")
      }
      answer += value
    }
  } catch (err) {
    recovered = true
    message = err instanceof Error ? err.message : "unknown"
    answer = clamp(answer, 0, 100)
  } finally {
    if (!recovered) {
      message = "clean"
    }
  }

  {
    // bare block scope
    const bonus = recovered ? 1 : 0
    answer += bonus
  }

  return {
    recovered,
    message,
    answer,
  }
}

const program = thunk {
  const stats = run classify
  const sums = run accumulate
  const safety = run guarded

  let score = stats.positives * 2 + sums.total
  if (safety.recovered) {
    score -= 3
  } else {
    score += 1
  }

  for (let n = 0; n < 3; n++) {
    score += n
  }

  return {
    stats,
    sums,
    safety,
    score,
  }
}

const result = run program
console.log(JSON.stringify(result, null, 2))
