file requires of Examples

// Example: Requires + use / provide via first-class symbol

import { use, provide, type Thunk } from "@thunk/runtime"

symbol Config = {
  environment: string;
}

const ProductionConfig = Config({
  environment: "prod",
});

interface User {
  id: string
  name: string
}

symbol Database {
  name: string;

  getUser: (id: string) => Thunk<User>;
}

const DatabaseLive = thunk {
  const config = run use(Config)
  return Database({
    name: config.environment,
    getUser: (id: string) => thunk {
      return {
        id,
        name: "John Doe",
      }
    }
  });
}

const fetchUser = thunk {
  const db = run use(Database)
  const user = run db.getUser("1234")
  return db.name + " " + user.name
}

const program = thunk {
  const db = run DatabaseLive
  return run provide(
    fetchUser,
    db,
  );
}

const result = run provide(program, ProductionConfig)
console.log(result)
