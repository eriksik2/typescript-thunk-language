// Example: Requires + use / provide via first-class symbol

import { use, provide, layerOf } from "@thunk/runtime"

symbol Database {
  name: string
}

const DatabaseLive = Database({
  name: "live"
})

const fetchUser = thunk {
  const db = run use(Database)
  return db.name
}

const program: Thunk<string> = provide(
  fetchUser,
  //layerOf(Database, DatabaseLive),
  DatabaseLive,
)

const result = run program
console.log(result)