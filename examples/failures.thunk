/**
 * Hierarchical + abstract symbols, and the built-in Failure tree.
 *
 * Run:  bun run thunk run examples/failures.thunk
 */

import {
  Failure,
  Defect,
  UnhandledError,
  Error,
  Symbol,
} from "@thunk/runtime"

const defect: Failure = Defect({ message: "invariant violated" })
const unhandled: Failure = UnhandledError({ message: "promise rejected" })
const err: Failure = Error({ message: "not found" })

const checks = thunk {
  const a = Symbol.is(defect, Failure)
  const b = Symbol.is(defect, Defect)
  const c = Symbol.is(defect, UnhandledError)
  const d = Symbol.is(unhandled, Failure)
  const e = Symbol.is(err, Error)
  const leaf = Symbol.of(defect)
  return { a, b, c, d, e, leafIsDefect: leaf === Defect }
}

const result = run checks
console.log(result)
