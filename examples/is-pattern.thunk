file isPattern of Examples

import { Error, Symbol } from "@thunk/runtime"

symbol NotFound extends Error {
  path: string
}
symbol Conflict extends Error {
  resource: string
}
type AppErr = NotFound | Conflict

/** Pedigree: any Error arm vs success number. */
const describe = (r: number | AppErr) => thunk {
  if (r is any Error: infer e) {
    return "err " + e.message
  }
  if (r > 0) {
    return "pos " + r
  }
  return "non-positive"
}

/** Exact leaf arms. */
const handled = (r: number | AppErr) => thunk {
  if (r is NotFound { path: infer p }) {
    return "missing " + p
  }
  if (r is Conflict { resource: infer res }) {
    return "conflict " + res
  }
  return "ok " + r
}

const a = run describe(3)
const b = run describe(NotFound({ message: "gone", path: "/x" }))
const c = run handled(Conflict({ message: "busy", resource: "lock" }))
const flag = NotFound({ message: "x", path: "/" }) is any Error
const exact = NotFound({ message: "x", path: "/" }) is Error
const _pedigree = Symbol.isAny(
  NotFound({ message: "x", path: "/" }),
  Error,
)
