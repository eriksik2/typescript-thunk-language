file tryErrors of Examples

/**
 * Fallibility: `Thunk<T> Fail(E)` + `try` sugar.
 *
 * Fail is part of the thunk type (before protocols): success T, error arms E.
 * Encodes as yield `T | E`. `try` early-returns Error-pedigree arms.
 */

import { Error, type Thunk } from "@thunk/runtime"

symbol DivideByZero extends Error {}

const div = (a: number, b: number): Thunk<number> Fail(DivideByZero) => thunk {
  return b === 0 ? DivideByZero({ message: "divide by zero" }) : a / b
}

/** Handle locally via `run` — yield stays success-only. */
const safe = (a: number, b: number): Thunk<number> => thunk {
  const res = run div(a, b)
  if (res is DivideByZero) return 0
  // State-machine lowering splits branches; assert success arm.
  return res as number
}

/** Propagate via `try` — enclosing yield includes DivideByZero. */
const propagate = (
  a: number,
  b: number,
): Thunk<number> Fail(DivideByZero) => thunk {
  const n = try div(a, b)
  return n + 1
}

/** Pedigree catch-all. */
const anyError = (
  a: number,
  b: number,
): Thunk<number> Fail(DivideByZero) => thunk {
  const res = run div(a, b)
  if (res is any Error) return res
  return res as number
}

const ok = run safe(10, 2)
const zero = run safe(10, 0)
const prop = run propagate(10, 2)
console.log({ ok, zero, prop })
